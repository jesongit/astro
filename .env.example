# 构建期非秘密变量示例(计划 §13.1)。
# 复制为 .env.local 供 astro dev/build 使用;真实 secret 绝不入库。

# Google 站点验证(公开可选)
PUBLIC_GOOGLE_SITE_VERIFICATION=

# ——— 仅本地 Wrangler 预览使用(pages dev 时模拟 bindings 的非秘密变量)———
# 生产/预览的真实值在 Cloudflare 控制台 / wrangler.jsonc 配置,绝不写入本文件。
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=
ADMIN_ALLOWED_HOSTS=
ADMIN_EMAILS=
