{
  "name": "astro-paper",
  "type": "module",
  "version": "5.5.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build && pagefind --site dist && node ./scripts/copy-pagefind.mjs",
    "preview": "astro preview",
    "preview:cloudflare": "wrangler pages dev dist",
    "sync": "astro sync",
    "astro": "astro",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:e2e": "playwright test",
    "typecheck": "astro check && tsc --noEmit -p workers/portfolio-sync/tsconfig.json",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "check:artifact": "node ./scripts/check-artifact.mjs",
    "check:routes": "node ./scripts/check-routes.mjs",
    "verify:all": "node ./scripts/verify-all.mjs",
    "deploy:site:preview": "wrangler pages deploy dist --branch preview",
    "deploy:sync:preview": "wrangler deploy --config workers/portfolio-sync/wrangler.jsonc --env preview"
  },
  "dependencies": {
    "@astrojs/cloudflare": "12.6.13",
    "@astrojs/rss": "^4.0.14",
    "@astrojs/sitemap": "^3.6.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.1.18",
    "@types/hast": "^3.0.4",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "astro": "^5.16.6",
    "dayjs": "^1.11.19",
    "hast-util-to-string": "^3.0.1",
    "jose": "^5.9.6",
    "lodash.kebabcase": "^4.1.1",
    "remark-collapse": "^0.1.2",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-toc": "^9.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "satori": "^0.18.3",
    "sharp": "^0.34.5",
    "slugify": "^1.6.6",
    "tailwindcss": "^4.1.18",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@cloudflare/vitest-pool-workers": "^0.8.19",
    "@cloudflare/workers-types": "^4.20250913.0",
    "@pagefind/default-ui": "^1.4.0",
    "@playwright/test": "^1.49.0",
    "@shikijs/transformers": "^3.20.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/lodash.kebabcase": "^4.1.9",
    "@typescript-eslint/parser": "^8.51.0",
    "eslint": "^9.39.2",
    "eslint-plugin-astro": "^1.5.0",
    "globals": "^16.5.0",
    "pagefind": "^1.4.0",
    "prettier": "^3.7.4",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.51.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.0.0"
  }
}
