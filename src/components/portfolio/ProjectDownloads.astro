---
/**
 * 版本与下载模块(计划 §7.4 / §11.2):
 * - 只渲染真实存在的正式 Release,版本与附件直接链接 GitHub;
 * - 附件按平台分组,默认只展开第一个有文件的分组;
 * - 源代码 zip/tar 单列「源代码」,不冒充安装包。
 */
import type { ProjectPlatform, ProjectRelease } from "@/lib/portfolio/types";

interface Props {
  release: ProjectRelease;
}

const { release } = Astro.props;

const PLATFORM_GROUPS: { key: ProjectPlatform; label: string }[] = [
  { key: "windows", label: "Windows" },
  { key: "macos", label: "macOS" },
  { key: "linux", label: "Linux" },
  { key: "other", label: "其他附件" },
  { key: "checksum", label: "校验与其他文件" },
];

const groups = PLATFORM_GROUPS.map(({ key, label }) => ({
  key,
  label,
  assets: release.assets.filter(asset => asset.platform === key),
})).filter(group => group.assets.length > 0);

function formatSize(bytes: number): string {
  if (!Number.isFinite(bytes) || bytes <= 0) return "";
  const units = ["B", "KB", "MB", "GB"] as const;
  let value = bytes;
  let unit = 0;
  while (value >= 1024 && unit < units.length - 1) {
    value /= 1024;
    unit += 1;
  }
  return `${value >= 100 ? Math.round(value) : value.toFixed(1)} ${units[unit]}`;
}

const publishedDate = release.publishedAt.slice(0, 10);
---

<div>
  <div class="flex flex-wrap items-baseline gap-4">
    <span class="font-serif text-2xl font-semibold text-accent">
      {release.tagName}
    </span>
    <span class="font-mono text-xs text-foreground/60">
      {publishedDate} 发布
    </span>
    <a
      href={release.releaseUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="ms-auto border-b border-border pb-0.5 text-[12.5px] text-foreground/60 transition-colors hover:border-accent hover:text-accent"
    >
      在 GitHub 查看 Release →
    </a>
  </div>

  {
    release.notes.length > 0 && (
      <ul class="mt-3 mb-6 list-disc ps-5 text-[13.5px] text-foreground/70">
        {release.notes.map(note => (
          <li class="my-0.5">{note}</li>
        ))}
      </ul>
    )
  }

  <div>
    {
      groups.map((group, index) => (
        <details class="group border-t border-border" open={index === 0}>
          <summary class="flex cursor-pointer items-baseline gap-3.5 py-3.5 text-[13px] font-semibold tracking-[0.18em] [&::-webkit-details-marker]:hidden">
            <span
              aria-hidden="true"
              class="font-mono text-[10px] text-accent transition-transform group-open:rotate-90"
            >
              ▶
            </span>
            {group.label}
            <span class="ms-auto font-mono text-[11px] font-normal tracking-normal text-foreground/50">
              {group.assets.length} 个文件
            </span>
          </summary>
          <div class="border-t border-dashed border-border">
            {group.assets.map(asset => (
              <div class="flex flex-wrap items-baseline gap-x-3.5 gap-y-1 border-b border-dashed border-border py-2.5 ps-6 text-[13.5px] last:border-b-0">
                <span class="font-mono text-xs">{asset.name}</span>
                <span class="font-mono text-[11px] text-foreground/50">
                  {formatSize(asset.sizeBytes)}
                </span>
                <a
                  href={asset.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="ms-auto text-xs tracking-[0.12em] whitespace-nowrap text-accent hover:underline hover:underline-offset-4"
                >
                  下载 ↓
                </a>
              </div>
            ))}
          </div>
        </details>
      ))
    }
  </div>

  {
    (release.sourceZipUrl || release.sourceTarUrl) && (
      <p class="flex flex-wrap items-baseline gap-x-5 gap-y-2 border-t border-border py-4 text-[13px] text-foreground/60">
        <span>源代码:</span>
        {release.sourceZipUrl && (
          <a
            href={release.sourceZipUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-accent hover:underline hover:underline-offset-4"
          >
            Source code (zip)
          </a>
        )}
        {release.sourceTarUrl && (
          <a
            href={release.sourceTarUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-accent hover:underline hover:underline-offset-4"
          >
            Source code (tar.gz)
          </a>
        )}
      </p>
    )
  }
</div>
