---
/**
 * 首页(计划 §11.1,按需渲染):
 * 内容顺序:简短介绍 → 精选作品(≤6,经发布门禁)→ 全部作品入口
 * → 最新文章(4 篇,复用 Content Layer 构建快照 + postFilter)→ 置顶文章入口。
 * 精选为空不显示空框;作品服务不可用时保留文章区并给出简短状态。
 */
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import LinkButton from "@/components/LinkButton.astro";
import Card from "@/components/Card.astro";
import ProjectGrid from "@/components/portfolio/ProjectGrid.astro";
import { listPublicProjects } from "@/lib/portfolio/view";
import type { PostSnapshot } from "@/utils/postsSnapshot";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { SITE } from "@/config";
import { SOCIALS } from "@/constants";

export const prerender = false;

/**
 * 文章区数据来自构建期快照(计划 §11.1):workerd 不能加载 astro:content,
 * 经 Pages ASSETS binding 读取预渲染 JSON;本地 dev 无 runtime 则直接回源取。
 * 快照已过 postFilter 并按时间排序(见 /snapshots/latest-posts.json)。
 */
const assets = (
  Astro.locals.runtime?.env as
    | { ASSETS?: { fetch: (request: Request) => Promise<Response> } }
    | undefined
)?.ASSETS;
const snapshotUrl = new URL("/snapshots/latest-posts.json", Astro.url);
const snapshotResponse = assets
  ? await assets.fetch(new Request(snapshotUrl))
  : await fetch(snapshotUrl);
const sortedPosts: PostSnapshot[] = await snapshotResponse.json();

const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);

// 经发布门禁的精选与已展示作品(按人工顺序)
// projects.json 已由 Actions 按精选与优先级排序；公开页只读取该快照。
const featuredProjects = await listPublicProjects(Astro.locals, { limit: 6 });
const latestProjects: typeof featuredProjects = [];
const portfolioAvailable =
  featuredProjects.length > 0 || latestProjects.length > 0;

// 结构化数据:WebSite + Person(计划 §12.1)
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: SITE.title,
    description: SITE.desc,
    url: SITE.website,
  },
  {
    "@context": "https://schema.org",
    "@type": "Person",
    name: SITE.author,
    url: SITE.profile,
  },
];
---

<Layout structuredData={structuredData}>
  <Header />
  <main id="main-content" data-layout="index" class="app-layout">
    <section id="hero" class="border-b border-border pt-16 pb-14">
      <p class="kicker">个人站点 · 作品与文字</p>
      <h1
        class="mt-5 mb-3 font-serif text-4xl font-bold tracking-wide sm:text-5xl"
      >
        {SITE.title}
      </h1>
      <p class="text-foreground/70">{SITE.desc}</p>
      <a
        target="_blank"
        href="/rss.xml"
        class="mt-2 inline-block align-middle"
        aria-label="RSS 订阅"
        title="RSS 订阅"
      >
        <IconRss
          width={20}
          height={20}
          class="scale-125 stroke-accent stroke-3 rtl:-rotate-90"
        />
        <span class="sr-only">RSS Feed</span>
      </a>
      {
        SOCIALS.length > 0 && (
          <div class="mt-4 flex max-sm:flex-col sm:items-center">
            <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">社交链接：</div>
            <Socials />
          </div>
        )
      }
    </section>

    <!-- 01 精选作品(经发布门禁;最多 6) -->
    <section class="pt-14 pb-2" aria-labelledby="featured-heading">
      <div class="mb-6 flex items-baseline gap-4">
        <span class="font-serif text-accent italic">01</span>
        <h2
          id="featured-heading"
          class="font-serif text-2xl font-semibold tracking-wide"
        >
          精选作品
        </h2>
        <span class="ms-auto text-[10px] tracking-[0.4em] text-foreground/50">
          FEATURED
        </span>
      </div>

      {
        featuredProjects.length > 0 ? (
          <ProjectGrid projects={featuredProjects} heading="h3" />
        ) : (
          <p class="border-b border-border pb-8 text-sm text-foreground/60">
            {portfolioAvailable
              ? "暂无人工精选,以下为已展示作品。"
              : "作品资料暂时无法展示,稍后再来看看。"}
          </p>
        )
      }
      {
        featuredProjects.length === 0 && latestProjects.length > 0 && (
          <ProjectGrid projects={latestProjects} heading="h3" class="mt-6" />
        )
      }

      <div
        class="flex items-center justify-between border-b border-border py-8"
      >
        <LinkButton href="/projects/" class="btn-line">
          全部作品
          <IconArrowRight class="inline-block rtl:-rotate-180" />
        </LinkButton>
        <span class="font-mono text-[11px] text-foreground/50">
          {
            featuredProjects.length > 0
              ? `精选 ${featuredProjects.length} / 上限 6`
              : "全部作品入口"
          }
        </span>
      </div>
    </section>

    <!-- 02 最新文章 -->
    <section class="pt-12 pb-4" aria-labelledby="posts-heading">
      <div class="mb-4 flex items-baseline gap-4">
        <span class="font-serif text-accent italic">02</span>
        <h2
          id="posts-heading"
          class="font-serif text-2xl font-semibold tracking-wide"
        >
          最新文章
        </h2>
        <span class="ms-auto text-[10px] tracking-[0.4em] text-foreground/50">
          RECENT POSTS
        </span>
      </div>
      <ul>
        {
          recentPosts.map(
            (data, index) =>
              index < SITE.postPerIndex && <Card variant="h3" {...data} />
          )
        }
      </ul>
    </section>

    {
      featuredPosts.length > 0 && (
        <section class="pt-8 pb-4" aria-labelledby="pinned-heading">
          <h2 id="pinned-heading" class="text-xl font-semibold tracking-wide">
            置顶文章
          </h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href="/posts/">
        全部文章
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>
